# --- BigQuery (your GCP billing project) ---
GCP_PROJECT_ID=your-gcp-project-id

# ACME workshop dataset (Module 2–3 default)
BIGQUERY_DATASET_ID=acme_corp

# --- Neo4j (AuraDB or Desktop) ---
# AuraDB:  neo4j+s://xxxxxxxx.databases.neo4j.io
# Desktop: neo4j://localhost:7687
NEO4J_URI=neo4j+s://YOUR_AURA_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD

# Workshop ACME graph uses NEO4J_DATABASE=neo4j (or your Aura instance id).
# Census ACS demo uses a separate database — see CENSUS_NEO4J_DATABASE below.
NEO4J_DATABASE=neo4j

# --- LLM & embeddings ---
OPENAI_API_KEY=sk-...your-key-here...
# Optional — enables Anthropic models in census_agent*.py menus
ANTHROPIC_API_KEY=

AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# --- Census Bureau ACS demo (public data — no copy into your project) ---
# Data: https://console.cloud.google.com/marketplace/product/bigquery-public-data/census-bureau-acs
CENSUS_SOURCE_PROJECT=bigquery-public-data
CENSUS_SOURCE_DATASET=census_bureau_acs
CENSUS_NEO4J_DATABASE=census

# Census agent tuning (optimized agent)
# CENSUS_COMPACT_MAX_TABLES=1
# CENSUS_COMPACT_DESCRIPTIONS=0
